---
import { clinics, waUrl } from '../../data/clinics';
import { rating } from '../../data/reviews';
---
<section class="hero" id="inicio">
  <img
    class="hero-bg"
    src="/assets/images/hero/hero1.avif"
    alt=""
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <span class="hero-location">Argés · Toledo — Majadahonda · Madrid</span>
      <h1 class="hero-title">Tu dentista<br />de confianza.</h1>
      <p class="hero-sub">Odontología de vanguardia con el trato cercano que mereces. Dos clínicas, un mismo compromiso con tu salud.</p>
      <div class="hero-trust">
        <span class="hero-stars" aria-hidden="true">★★★★★</span>
        <span><strong>{rating.score}</strong> sobre 5 · {rating.count} reseñas verificadas en Google</span>
      </div>
    </div>

    <aside class="hero-cta-card" aria-label="Pedir cita por WhatsApp">
      <span class="hero-cta-eyebrow">Primera consulta gratuita</span>
      <p class="hero-cta-headline">¿A qué clínica<br />quieres venir?</p>
      <div class="hero-cta-btns">
        {clinics.map((c, i) => (
          <a
            href={waUrl(c, `Hola, me gustaría pedir cita en ${c.shortName}.`)}
            class:list={['hero-cta-btn', i === 0 ? 'hcb-gold' : 'hcb-outline']}
            target="_blank"
            rel="noopener"
          >
            <span class="hcb-clinic">{c.name.replace(', ', ' · ')}</span>
            <span class="hcb-phone">{c.phone[0]}</span>
          </a>
        ))}
      </div>
      <p class="hero-cta-note">Respondemos por WhatsApp hoy</p>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(88svh - var(--nav-h));
    padding-block: 64px 56px;
    overflow: hidden;
    background: var(--black);
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(110deg, rgba(20,18,16,.92) 0%, rgba(20,18,16,.82) 60%, rgba(20,18,16,.68) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  .hero-content { max-width: 560px; }

  .hero-location {
    display: block;
    font-size: 11px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--muted-dark);
    margin-bottom: 22px;
    animation: fadeUp .8s var(--ease) .1s both;
  }
  .hero-title {
    font-size: clamp(42px, 5.5vw + 14px, 76px);
    line-height: 1.0;
    letter-spacing: -1.5px;
    color: var(--on-dark);
    margin-bottom: 20px;
    animation: fadeUp .8s var(--ease) .22s both;
  }
  .hero-sub {
    max-width: 440px;
    font-size: clamp(15px, .4vw + 14px, 16px);
    line-height: 1.7;
    color: rgba(240,237,230,.62);
    margin-bottom: 32px;
    animation: fadeUp .8s var(--ease) .34s both;
  }
  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    padding-top: 24px;
    border-top: 1px solid var(--border-dark);
    font-size: 13px;
    color: rgba(240,237,230,.62);
    animation: fadeUp .8s var(--ease) .46s both;
  }
  .hero-stars { color: var(--gold); letter-spacing: 1px; }
  .hero-trust strong { color: var(--on-dark); font-weight: 600; }

  /* Tarjeta CTA: oculta en móvil (nav + WhatsApp flotante cubren la conversión) */
  .hero-cta-card { display: none; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 640px) {
    .hero { padding-block: 88px 72px; }
    .hero-cta-card {
      display: block;
      max-width: 440px;
      background: var(--black);
      border: 1px solid rgba(240,237,230,.08);
      padding: 28px;
    }
    .hero-cta-eyebrow {
      display: block;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 12px;
    }
    .hero-cta-headline {
      font-family: var(--font-serif);
      font-size: 22px;
      font-weight: 500;
      line-height: 1.3;
      color: var(--on-dark);
      margin-bottom: 24px;
    }
    .hero-cta-btns {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 18px;
    }
    .hero-cta-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 52px;
      padding: 14px 20px;
      border-radius: 3px;
      transition: background-color .25s var(--ease), border-color .25s var(--ease),
                  transform .25s var(--ease), box-shadow .25s var(--ease);
    }
    .hcb-gold { background: var(--gold); color: var(--black); }
    .hcb-gold:hover {
      background: var(--gold-lt);
      transform: translateY(-1px);
      box-shadow: 0 4px 16px rgba(201,160,96,.25);
    }
    .hcb-outline { border: 1px solid rgba(240,237,230,.22); color: var(--on-dark); }
    .hcb-outline:hover { border-color: rgba(240,237,230,.55); background: rgba(240,237,230,.06); }
    .hcb-clinic { font-size: 14px; font-weight: 500; }
    .hcb-phone { font-size: 12px; opacity: .65; white-space: nowrap; }
    .hero-cta-note {
      font-size: 11px;
      line-height: 1.5;
      text-align: center;
      color: var(--muted-dark);
    }
  }

  @media (min-width: 900px) {
    .hero { min-height: calc(100svh - var(--nav-h)); padding-block: 96px 80px; }
    .hero-inner { grid-template-columns: 1fr 340px; gap: 48px; }
    .hero-cta-card { max-width: none; padding: 32px; }
    .hero-location { margin-bottom: 28px; }
    .hero-title { margin-bottom: 22px; }
    .hero-sub { margin-bottom: 40px; }
    .hero-trust { padding-top: 28px; }
  }

  @media (min-width: 1200px) {
    .hero-inner { grid-template-columns: 1fr 370px; gap: 56px; }
  }
</style>
