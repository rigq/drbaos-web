---
import type { TeamMember } from '../../data/team';

interface Props {
  members: TeamMember[];
  /** Alt alternativo: "{name}, dentista en Majadahonda" */
  altSuffix?: string;
}
const { members, altSuffix } = Astro.props;
---
<div class:list={['team-grid', members.length > 3 && 'team-grid--4']}>
  {members.map((m) => (
    <article class="member">
      <div class="member-photo">
        <img src={m.photo} alt={altSuffix ? `${m.name}, ${altSuffix}` : m.name} width="600" height="750" loading="lazy" decoding="async" />
      </div>
      <div class="member-info">
        <h3 class="member-name">{m.name}</h3>
        <p class="member-role">{m.role}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
  }
  .member-photo {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--cream);
  }
  .member-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform .7s var(--ease);
  }
  .member-info {
    padding-block: 14px;
    border-bottom: 1px solid var(--border-light);
  }
  .member-name {
    font-size: clamp(17px, 1vw + 13px, 22px);
    letter-spacing: -.3px;
    color: var(--black);
  }
  .member-role {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--muted-light);
    margin-top: 4px;
  }

  @media (min-width: 640px) {
    .team-grid { grid-template-columns: repeat(3, 1fr); gap: 32px 24px; }
    .member-role { font-size: 11px; letter-spacing: .15em; }
  }
  @media (min-width: 900px) {
    .team-grid--4 { grid-template-columns: repeat(4, 1fr); }
    .team-grid { gap: 40px; }
  }
  @media (hover: hover) {
    .member:hover .member-photo img { transform: scale(1.04); }
  }
</style>
