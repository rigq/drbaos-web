---
import ClinicDetails from './ClinicDetails.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { waUrl, type Clinic } from '../../data/clinics';

interface Props {
  clinic: Clinic;
  image: { src: string; width: number; height: number };
}

const { clinic, image } = Astro.props;
const waHref = waUrl(clinic, `Hola, me gustaría pedir cita en ${clinic.shortName}.`);
---
<article class="centro">
  <div class="centro-img">
    <img src={image.src} alt={`Clínica Dental Dr. Baos ${clinic.name}`} width={image.width} height={image.height} loading="lazy" decoding="async" />
  </div>
  <div class="centro-body">
    <span class="centro-tag">{clinic.tag}</span>
    <h3 class="centro-name">{clinic.name}</h3>
    <ClinicDetails clinic={clinic} />
    <a href={clinic.mapsUrl} class="centro-maps" target="_blank" rel="noopener">Ver en Google Maps →</a>
    <div class="centro-actions">
      <a href={waHref} class="btn btn-gold btn-full" target="_blank" rel="noopener">
        <WhatsAppIcon size={14} />
        Pedir cita en {clinic.shortName}
      </a>
      <a href={clinic.pageUrl} class="btn btn-outline-dark btn-full">Ver clínica</a>
    </div>
  </div>
</article>

<style>
  .centro {
    position: relative;
    overflow: hidden;
    background: var(--white);
    box-shadow: inset 0 3px 0 var(--gold);
    transition: box-shadow .35s var(--ease);
  }
  .centro-img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .centro-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .7s var(--ease);
  }

  .centro-body { padding: 28px 20px 32px; }
  .centro-tag {
    display: block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 10px;
  }
  .centro-name {
    font-size: clamp(22px, 1vw + 18px, 26px);
    color: var(--black);
    letter-spacing: -.3px;
    margin-bottom: 18px;
  }
  .centro-maps {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap);
    margin-block: 8px 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--gold-ink);
    transition: gap .2s;
  }
  .centro-maps:hover { gap: 10px; }
  .centro-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  @media (min-width: 640px) {
    .centro-body { padding: 32px 32px 36px; }
  }

  @media (min-width: 900px) {
    .centro-img { aspect-ratio: auto; height: 280px; }
    .centro-body { padding: 36px; }
    .centro-maps { font-size: 13px; }
  }

  @media (hover: hover) {
    .centro:hover {
      box-shadow: inset 0 3px 0 var(--gold), 0 20px 48px rgba(20,18,16,.07);
      z-index: 1;
    }
    .centro:hover .centro-img img { transform: scale(1.04); }
  }
</style>
