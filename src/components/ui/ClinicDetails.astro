---
// Dirección, teléfonos y horario de una clínica. Se usa en fondo claro y oscuro.
import { telHref, type Clinic } from '../../data/clinics';

interface Props {
  clinic: Clinic;
  tone?: 'light' | 'dark';
}

const { clinic, tone = 'light' } = Astro.props;
---
<ul class:list={['details', `details--${tone}`]}>
  <li>
    <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0a5 5 0 00-5 5c0 3.9 5 9 5 9s5-5.1 5-9a5 5 0 00-5-5zm0 7a2 2 0 110-4 2 2 0 010 4z"/></svg>
    <span class="sr-only">Dirección: </span><span>{clinic.address}</span>
  </li>
  <li>
    <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 1.5A1.5 1.5 0 001.5 3C1.5 9.9 6.1 14.5 13 14.5A1.5 1.5 0 0014.5 13v-2a1.5 1.5 0 00-1-1.4l-2-.7a1.5 1.5 0 00-1.5.4l-.7.7a8 8 0 01-3.3-3.3l.7-.7a1.5 1.5 0 00.4-1.5l-.7-2A1.5 1.5 0 005 1.5H3z"/></svg>
    <span class="sr-only">Teléfono: </span>
    <span class="phones">
      {clinic.phone.map((p) => <a href={telHref(p)}>{p}</a>)}
    </span>
  </li>
  <li>
    <svg class="icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1a7 7 0 100 14A7 7 0 008 1zm.5 7.7-3 1.5-.5-.9 2.5-1.3V4h1v4.7z"/></svg>
    <span class="sr-only">Horario: </span><span>{clinic.hours}</span>
  </li>
</ul>

<style>
  .details {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .details li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.5;
  }
  .icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
    opacity: .5;
    margin-top: 3px;
  }
  .phones {
    display: flex;
    flex-wrap: wrap;
    column-gap: 16px;
  }
  /* El teléfono es un enlace táctil: altura mínima sin descuadrar la línea */
  .phones a {
    font-weight: 500;
    padding-block: 12px;
    margin-block: -12px;
  }

  .details--light li { color: var(--muted-light); }
  .details--light a { color: var(--black); }

  .details--dark li { color: var(--muted-dark); }
  .details--dark a { color: var(--on-dark); }

  @media (min-width: 900px) {
    .details li { font-size: 13px; }
  }
</style>
