---
import PageLayout from '../layouts/PageLayout.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import ClinicasSection from '../components/sections/ClinicasSection.astro';
import SobreSection from '../components/sections/SobreSection.astro';
import TratamientosSection from '../components/sections/TratamientosSection.astro';
import EquipoSection from '../components/sections/EquipoSection.astro';
import PlanVIPSection from '../components/sections/PlanVIPSection.astro';
import ResenasSlider from '../components/sections/ResenasSlider.astro';
import ContactoSection from '../components/sections/ContactoSection.astro';
import { clinics } from '../data/clinics';
import { organizationSchema, clinicSchema } from '../data/schema';

const schema = [
  organizationSchema(),
  ...clinics.map((c) => clinicSchema(c, `Clínica dental en ${c.locality} (${c.region}): implantes, ortodoncia invisible, estética dental, endodoncia, periodoncia, cirugía oral y odontopediatría.`)),
];
---
<PageLayout
  title="Clínica Dental Dr. Baos | Dentista en Toledo y Madrid"
  description="Clínica Dental Dr. Baos: odontología de vanguardia con trato cercano. Argés (Toledo) y Majadahonda (Madrid). 4,9★ en Google. Pide cita por WhatsApp."
  schema={schema}
>
  <HeroSection />
  <ClinicasSection />
  <SobreSection />
  <TratamientosSection />
  <EquipoSection />
  <PlanVIPSection />
  <ResenasSlider />
  <ContactoSection />
</PageLayout>
